use:
	- nette
	- modernizations

typeAnalysis: phpstan

paths:
	- src
	- tests

fileExtensions:
	- php
	- phpt

imports: {grouping: {class: grouped}}

overrides:
	-
		paths: [src]
		nameResolution: certain
		use:
			- compilerOptimizations
			- deprecations

	- # in_array() deduplicates closures, which only a loose comparison finds equal
		paths: [src/ComponentModel/Component.php]
		mistakes: {strictArgument: keep}
